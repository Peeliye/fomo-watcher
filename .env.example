# 首次种入一组有效会话；之后由无窗口 Chromium 中的 Privy SDK 自动轮换。
FOMO_ACCESS_TOKEN=
FOMO_REFRESH_TOKEN=

# 可选：用于把英文喊单翻译为中文。兼容 OpenAI Chat Completions 的服务均可。
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=

# Telegram
TG_BOT_TOKEN=
TG_CHAT_ID=

# 飞书群机器人
FEISHU_WEBHOOK_URL=

# 任意自建消息桥。POST JSON: {"text": "...", "event": {...}}
GENERIC_WEBHOOK_URL=

# RPC URL/密钥只保存在本机 .env。每条链建议一个主节点和一个不同供应商的备用节点。
RPC_ETHEREUM_URL=
RPC_ETHEREUM_WSS=
RPC_ETHEREUM_BACKUP_URL=
RPC_ETHEREUM_BACKUP_WSS=
RPC_BSC_URL=
RPC_BSC_WSS=
RPC_BSC_BACKUP_URL=
RPC_BSC_BACKUP_WSS=
RPC_ROBINHOOD_URL=
RPC_ROBINHOOD_WSS=
RPC_ROBINHOOD_BACKUP_URL=
RPC_ROBINHOOD_BACKUP_WSS=
RPC_ARC_URL=https://rpc.mainnet.arc.io
RPC_ARC_WSS=
RPC_ARC_BACKUP_URL=
RPC_ARC_BACKUP_WSS=
RPC_BASE_URL=
RPC_BASE_WSS=
RPC_BASE_BACKUP_URL=
RPC_BASE_BACKUP_WSS=
RPC_SOLANA_URL=
RPC_SOLANA_WSS=
RPC_SOLANA_BACKUP_URL=
RPC_SOLANA_BACKUP_WSS=

# 聚合路由凭据。当前默认仍为 Shadow；只有独立 signer、广播和 live 模式全部显式启用后才会成交。
ZEROX_API_KEY=
JUPITER_API_KEY=

# 仅在对应报价/模拟适配器已经部署并验收后设置为 true。
ROUTE_0X_ENABLED=false
ROUTE_JUPITER_ENABLED=false
ROUTE_DIRECT_POOL_ENABLED=false

# 最终广播总开关。极速模式仍必须通过 RPC、可信主路由、交易花费范围、minOut 与 signer 门禁。
LIVE_BROADCAST_ENABLED=false

# 历史链上索引器（下一阶段自动拉取使用；普通免费 RPC 通常不能完整返回地址交易史）。
# EVM 可接支持地址历史与内部转账的索引器，Solana 需覆盖关联代币账户历史。
EVM_HISTORY_INDEXER_URL=
EVM_HISTORY_INDEXER_KEY=
SOLANA_HISTORY_INDEXER_URL=
SOLANA_HISTORY_INDEXER_KEY=
MARKET_HISTORY_API_URL=
MARKET_HISTORY_API_KEY=
