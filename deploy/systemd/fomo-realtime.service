[Unit]
Description=FOMO realtime WebSocket sidecar
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/fomo-watcher/sidecar
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
